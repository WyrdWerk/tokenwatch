# security headers (added 2026-09-15, security audit)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Cloudflare Pages custom headers
# Data JSON: always revalidate; ETag drives cheap 304s.
/*.json
  Cache-Control: public, max-age=0, must-revalidate

# Path-fingerprinted deploy assets (public/h/*) — immutable, unique URL per content hash.
# Query-string ?v= busting is insufficient: custom-domain edge has ignored ?v= in cache key.
/h/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed source names (repo/dev, or accidental direct hits) — always revalidate.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/image-app.js
  Cache-Control: public, max-age=0, must-revalidate
/video-app.js
  Cache-Control: public, max-age=0, must-revalidate
/shared-ui.js
  Cache-Control: public, max-age=0, must-revalidate
/webmcp.js
  Cache-Control: public, max-age=0, must-revalidate
/share-snapshot.mjs
  Cache-Control: public, max-age=0, must-revalidate

# Self-hosted fonts — immutable.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# External embed script loaded WITHOUT path hash by third-party sites — must revalidate.
/widget/embed.js
  Cache-Control: public, max-age=3600, must-revalidate

# SEO: noindex raw data files + API responses (they are data, not pages)
/api/*
  X-Robots-Tag: noindex
/openapi.json
  X-Robots-Tag: noindex
/pricing.json
  X-Robots-Tag: noindex
/image-pricing.json
  X-Robots-Tag: noindex
/video-pricing.json
  X-Robots-Tag: noindex
/performance.json
  X-Robots-Tag: noindex
